# ==========================================
# AI Recruitment Automation Platform (.env)
# ==========================================

# 1. Supabase (Database, Auth, Storage)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. AI Provider (Google Gemini Free Tier)
# Obtain your free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. n8n Automation Workflows
# Your hosted n8n instance base URL and a shared authentication token
N8N_BASE_URL=https://your-n8n-instance.com
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/cv-screener
N8N_SHARED_SECRET=generate_a_random_secure_secret_token_here

# 4. Google Workspace Integrations (Forms, Calendar, Meet)
# Configure OAuth 2.0 Credentials in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 5. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
